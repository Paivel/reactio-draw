#!/bin/bash
# Reactio Draw: checks structure recognition (MolScribe) on this Mac, without the app window.
# 1) finds or installs MolScribe in ~/.reactio-ocsr  2) reads a test picture (aspirin) with the app's reactio_ocsr.py
cd "$HOME"
py="$HOME/.reactio-ocsr/bin/python3"
script=""
for a in "/Applications/Reactio Draw.app" "$HOME/Applications/Reactio Draw.app"; do
  [ -f "$a/Contents/Resources/reactio_ocsr.py" ] && script="$a/Contents/Resources/reactio_ocsr.py"
done
if [ -z "$script" ]; then echo "reactio_ocsr.py is not in Reactio Draw.app: install the new Reactio Draw first."; read -n1 -p "Press a key"; exit 1; fi
echo "Script: $script"
if [ ! -x "$py" ]; then
  echo "MolScribe is not installed (~/.reactio-ocsr). It needs Python 3.10 and about 1-2 GB (PyTorch and the model)."
  pyb="$(command -v python3.10 || true)"
  if [ -z "$pyb" ]; then echo "python3.10 not found: install it (python.org or: brew install python@3.10), then run this again."; read -n1 -p "Press a key"; exit 1; fi
  read -p "Install it now? [y/N] " ok
  [ "$ok" = "y" ] || exit 0
  "$pyb" -m venv "$HOME/.reactio-ocsr" && "$py" -m pip install --upgrade pip && "$py" -m pip install "numpy<2" torch MolScribe huggingface_hub || { echo "Install failed (see above)."; read -n1 -p "Press a key"; exit 1; }
fi
echo "Reading the test picture (the first run downloads the model, a few minutes)..."
t0=$(date +%s)
printf '%s' '{"b64": "", "boxes": [[0, 0, 448, 392]]}' | "$py" -u "$script" > /tmp/reactio-ocsr-test.json 2>/tmp/reactio-ocsr-test.err
t1=$(date +%s)
"$py" - <<'PY'
import json
try:
    a = json.load(open("/tmp/reactio-ocsr-test.json"))
except Exception as e:
    print("No answer:", e); print(open("/tmp/reactio-ocsr-test.err").read()[-2000:]); raise SystemExit
if not a.get("ok"):
    print("Failed:", a.get("error")); raise SystemExit
r = a["results"][0]
print("SMILES read:", r.get("smiles"), " confidence:", round(r.get("confidence", 0), 3))
print("atoms:", len(r.get("atoms", [])), "bonds:", len(r.get("bonds", [])), "(aspirin: 13 atoms, 13 bonds)")
print("OK" if len(r.get("atoms", [])) == 13 else "Check: the atom count differs")
PY
echo "Time: $((t1-t0)) s"
read -n1 -p "Press a key to close"
